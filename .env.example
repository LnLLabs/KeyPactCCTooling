# Blockfrost mainnet project id (required).
# Create one at https://blockfrost.io/
VITE_BLOCKFROST_PROJECT_ID=

# Optional. Defaults to the Vite /blockfrost proxy in development,
# and https://cardano-mainnet.blockfrost.io/api/v0 in production.
VITE_BLOCKFROST_URL=

# Public HTTPS URL of public/rationale/lgtm.jsonld after deploy.
# Required for real votes: on-chain anchors cannot point at localhost.
# Example: https://your-domain.example/rationale/lgtm.jsonld
VITE_RATIONALE_URL=

# DeepSeek API key for constitutionality inspection (Vite /deepseek proxy).
# Do NOT use a VITE_ prefix — the key is injected server-side by the proxy.
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Optional override for the Cardano Constitution markdown source.
# Default: IntersectMBO cardano-constitution-2 markdown on GitHub.
# Fallback if fetch fails: /constitution/cardano-constitution.md
VITE_CONSTITUTION_URL=
