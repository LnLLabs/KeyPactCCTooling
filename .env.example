# Optional local seed for first browser launch (dev only).
# Only non-secret URLs are seeded. Blockfrost / DeepSeek keys must be pasted in Settings.
#
# Production on cc.brothershipool.org uses in-app Settings (localStorage).
# Host `dist/` as a static SPA with fallback to index.html.

# Not seeded into the browser anymore — paste in Settings.
VITE_BLOCKFROST_PROJECT_ID=

# Leave empty in dev to use the Vite /blockfrost CORS proxy.
VITE_BLOCKFROST_URL=

# Optional seed → Settings → rationale URL (public HTTPS / IPFS gateway)
VITE_RATIONALE_URL=https://gateway.pinata.cloud/ipfs/QmStxNez278vdY6eqWAZBiq6XdGes242G9VEsa3DPdVsL6

# Optional seed → Settings → constitution markdown URL
VITE_CONSTITUTION_URL=

# DeepSeek is NOT seeded from env. Paste it in Settings.
